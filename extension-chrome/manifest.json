{
    "manifest_version": 3,
    "name": "Yautja Bridge",
    "version": "0.2.0",
    "description": "Bio-helmet bridge — lets Yautja control this browser without debug ports",
    "permissions": [
        "debugger",
        "tabs",
        "tabGroups",
        "activeTab",
        "storage",
        "alarms",
        "management",
        "webRequest",
        "proxy"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "Yautja Bridge",
        "default_icon": {
            "32": "icon32.png",
            "192": "icon192.png"
        }
    },
    "icons": {
        "32": "icon32.png",
        "192": "icon192.png",
        "512": "icon512.png"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:* http://127.0.0.1:*"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content-gql.js"
            ],
            "run_at": "document_idle",
            "all_frames": false
        }
    ]
}

{
  "name": "yautja",
  "version": "0.1.0",
  "description": "Bio-helmet for browser-hunting LLMs — sensory cortex between CDP and LLM",
  "type": "module",
  "main": "dist/helmet.js",
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "lint": "tsc --noEmit",
    "monitor": "tsc && node dist/live-monitor.js",
    "helmet": "tsc && node dist/helmet-main.js",
    "thermal": "tsc && node dist/thermal-monitor.js"
  },
  "dependencies": {
    "classic-level": "^3.0.0",
    "playwright": "^1.49.0",
    "ulid": "^3.0.2",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
